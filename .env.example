# ---------------------------------------------------------------
# DoubtBridge environment variables
# Copy this file to ".env" and replace the placeholder values.
# NEVER commit your real .env file to GitHub.
# ---------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# "development" for your laptop, "production" when deployed over HTTPS
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where the SQLite database file is stored (folder is created automatically)
DB_PATH=./data/doubtbridge.db

# Professor registration policy:
#   approval -> professors can register, but an administrator must approve them (recommended)
#   open     -> professors are active immediately (only for local testing)
#   closed   -> professor self-registration is disabled
PROFESSOR_REGISTRATION=approval

# Max login/registration attempts per IP address per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Public URL of the site, used for links inside notification emails
APP_URL=http://localhost:3000

# ---------------- Optional: email notifications ----------------
# Leave SMTP_HOST empty to disable emails. In-app notifications still work.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# and SMTP_PASS must be a Google "App Password", not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DoubtBridge <no-reply@example.com>"
