{
  "name": "doubtbridge",
  "version": "1.0.0",
  "description": "DoubtBridge — a Student–Professor doubt solving portal built with HTML, CSS, vanilla JavaScript, Node.js, Express and SQLite.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "db:seed-demo": "node database/seed-demo.js",
    "db:reset": "node database/init.js --reset",
    "professors:list": "node scripts/professors.js list",
    "professors:approve": "node scripts/professors.js approve",
    "professors:reject": "node scripts/professors.js reject",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aneeytech-123/doubt-shell.git"
  },
  "keywords": [
    "doubt-solving",
    "education",
    "express",
    "sqlite",
    "web-technology"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide": "^1.61.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
